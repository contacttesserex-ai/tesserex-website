<?xml version="1.0" encoding="UTF-8"?>
<content>
  <!-- Site settings. Change the email, subject format, enquiry types or default theme here only. -->
  <config>
    <company>Tesserex Inc.</company>
    <contactEmail>contact.tesserex@gmail.com</contactEmail>
    <!-- Email subject format. {type} = enquiry type, {subject} = subject typed by the visitor. Keep in step with SUBJECT_FORMAT in the Apps Script. -->
    <subjectFormat>TessereX Website - {type} - {subject}</subjectFormat>
    <!-- Enquiry types in the form. key = which button preselects it (partner, investor, web). Keep in step with TYPES in the Apps Script. -->
    <enquiryTypes>
      <type key="partner">Partner Enquiries</type>
      <type key="investor">Investor Relations</type>
      <type key="web">Web Message</type>
    </enquiryTypes>
    <!-- Google Apps Script web app that receives the contact form (saves to a Google Sheet and emails contactEmail). Redeploy the script as a new version after editing it. -->
    <contactScriptUrl>https://script.google.com/macros/s/AKfycbzTJ87BCSOadKLbUPLDSRn5iXmyGDTd8YMipEL1aivtDM8twQn7ih-afktOW7FhVjjKgQ/exec</contactScriptUrl>
    <!-- dark, light or fire -->
    <defaultTheme>fire</defaultTheme>
  </config>

  <!-- Short labels and messages used by scripts -->
  <ui>
    <item key="sending">Sending…</item>
    <item key="delivered">Delivered ✓</item>
    <item key="live">live</item>
    <item key="themeLight">☀ Light</item>
    <item key="themeDark">🌙 Dark</item>
    <item key="themeFire">🔥 Fire</item>
    <item key="sendBtn">Send message</item>
    <item key="sendFail">We could not send your message. Please try again in a moment, or</item>
    <item key="captchaQ">Security check: what is {a} + {b}?</item>
    <item key="captchaWrong">That answer is not right. Please try the security check again.</item>
    <item key="useMailApp">use your email app instead.</item>
    <item key="sendingBtn">Sending…</item>
    <item key="sentTitleOk">Message sent</item>
    <item key="sentOk">Thank you! Your message has been sent to our team.</item>
    <item key="needFields">Please fill in every field.</item>
  </ui>

  <!-- Page copy. Each value may contain simple HTML such as <span class="grad">. {company} is replaced by the company name above. -->
  <texts>
    <!-- nav -->
    <text key="nav.a.1"><![CDATA[Why TessereX]]></text>
    <text key="nav.a.2"><![CDATA[How it works]]></text>
    <text key="nav.a.3"><![CDATA[Mobile payments]]></text>
    <text key="nav.a.4"><![CDATA[Technology]]></text>
    <text key="nav.a.5"><![CDATA[Who it’s for]]></text>
    <text key="nav.btn.1"><![CDATA[Get in touch]]></text>
    <!-- top -->
    <text key="top.eyebrow.1"><![CDATA[Instant global payments]]></text>
    <text key="top.h1.1"><![CDATA[Money that arrives <span class="grad">the moment you send it</span>]]></text>
    <text key="top.lead.1"><![CDATA[TessereX is payment infrastructure for a borderless world. Stablecoin and CBDC rails move value across countries in seconds, any hour of any day, with costs you can see upfront.]]></text>
    <text key="top.btn.1"><![CDATA[Partner with us]]></text>
    <text key="top.btn.2"><![CDATA[See how it works]]></text>
    <text key="top.span.1"><![CDATA[Instant settlement]]></text>
    <text key="top.span.2"><![CDATA[Open 24 × 7 × 365]]></text>
    <text key="top.span.3"><![CDATA[Transparent costs]]></text>
    <text key="top.span.4"><![CDATA[Compliance built in]]></text>
    <!-- why -->
    <text key="why.h2.1"><![CDATA[Cross-border payments, <span class="grad">rebuilt</span>]]></text>
    <text key="why.sub.1"><![CDATA[Today’s international transfers hop through banks, cut-off times and time zones. TessereX replaces the chain with one direct, always-on rail.]]></text>
    <text key="why.h3.1"><![CDATA[Traditional cross-border]]></text>
    <text key="why.span.1"><![CDATA[Settlement]]></text>
    <text key="why.b.1"><![CDATA[Days]]></text>
    <text key="why.span.2"><![CDATA[Availability]]></text>
    <text key="why.b.2"><![CDATA[Banking hours]]></text>
    <text key="why.span.3"><![CDATA[Route]]></text>
    <text key="why.b.3"><![CDATA[Chain of intermediaries]]></text>
    <text key="why.span.4"><![CDATA[Fees]]></text>
    <text key="why.b.4"><![CDATA[Revealed late]]></text>
    <text key="why.span.5"><![CDATA[Tracking]]></text>
    <text key="why.b.5"><![CDATA[Limited]]></text>
    <text key="why.h3.2"><![CDATA[With TessereX]]></text>
    <text key="why.span.6"><![CDATA[Settlement]]></text>
    <text key="why.b.6"><![CDATA[Instant]]></text>
    <text key="why.span.7"><![CDATA[Availability]]></text>
    <text key="why.b.7"><![CDATA[24 × 7 × 365]]></text>
    <text key="why.span.8"><![CDATA[Route]]></text>
    <text key="why.b.8"><![CDATA[Direct liquidity rail]]></text>
    <text key="why.span.9"><![CDATA[Fees]]></text>
    <text key="why.b.9"><![CDATA[Transparent]]></text>
    <text key="why.span.10"><![CDATA[Tracking]]></text>
    <text key="why.b.10"><![CDATA[End-to-end, live]]></text>
    <!-- how -->
    <text key="how.h2.1"><![CDATA[From send to settled in <span class="grad">four steps</span>]]></text>
    <text key="how.sub.1"><![CDATA[One simple experience for the sender, one rigorous engine underneath.]]></text>
    <text key="how.h3.1"><![CDATA[Send]]></text>
    <text key="how.p.1"><![CDATA[Choose an amount and a destination currency. You see the full cost before you confirm.]]></text>
    <text key="how.h3.2"><![CDATA[Convert]]></text>
    <text key="how.p.2"><![CDATA[Value moves onto stablecoin or CBDC rails, so it is ready to travel without a correspondent chain.]]></text>
    <text key="how.h3.3"><![CDATA[Route &amp; verify]]></text>
    <text key="how.p.3"><![CDATA[The network picks the best liquidity path while compliance checks run inline.]]></text>
    <text key="how.h3.4"><![CDATA[Settle]]></text>
    <text key="how.p.4"><![CDATA[The recipient receives funds in their own currency, final and traceable.]]></text>
    <!-- mobile -->
    <text key="mobile.h2.1"><![CDATA[Instant payments, <span class="grad">right from your phone</span>]]></text>
    <text key="mobile.sub.1"><![CDATA[Scan, confirm, done. The same global rails, wrapped in a flow anyone can use in a few taps. Tap a step to preview it.]]></text>
    <text key="mobile.h3.1"><![CDATA[Scan or choose]]></text>
    <text key="mobile.p.1"><![CDATA[Scan a QR code or pick a contact. Local QR and UPI-style flows are supported.]]></text>
    <text key="mobile.h3.2"><![CDATA[Review upfront]]></text>
    <text key="mobile.p.2"><![CDATA[See what you pay and what the recipient gets before you confirm.]]></text>
    <text key="mobile.h3.3"><![CDATA[Authorise securely]]></text>
    <text key="mobile.p.3"><![CDATA[Approve with biometrics while compliance checks run in the background.]]></text>
    <text key="mobile.h3.4"><![CDATA[Delivered]]></text>
    <text key="mobile.p.4"><![CDATA[Funds land in seconds, with a live receipt you can share.]]></text>
    <text key="mobile.h4.1"><![CDATA[Send money]]></text>
    <text key="mobile.small.1"><![CDATA[Scan a code or search contacts]]></text>
    <text key="mobile.small.2"><![CDATA[Point your camera at a QR code]]></text>
    <text key="mobile.span.1"><![CDATA[Aarav]]></text>
